# ==============================================================================
# WEBZIFIRE — Autonomous AI SEO & Content Automation Environment Variables
# Copy required values into .env.local (local) and Vercel Environment Variables
# ==============================================================================

# 1. Gemini AI (already configured in .env.local)
GEMINI_API_KEY=your_gemini_api_key

# 2. Supabase (Project Ref: toqdgsjkexzakhckntzz)
NEXT_PUBLIC_SUPABASE_URL=https://toqdgsjkexzakhckntzz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key

# 3. Email / SMTP (Hostinger Business Email or Gmail App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=inquire@webzifire.com
SMTP_PASS=your_email_password
SMTP_FROM_NAME=WebziFire
ADMIN_APPROVAL_EMAIL=inquire@webzifire.com

# 4. Security & Site URL
NEXT_PUBLIC_SITE_URL=https://webzifire.com
CRON_SECRET=replace_with_32_char_random_hex
ADMIN_DASHBOARD_PASSWORD=replace_with_strong_admin_password

# 5. Optional: Google Analytics 4 & Google Search Console Monitoring
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GSC_SITE_URL=https://webzifire.com/
# Paste the single-line JSON string of a Google Cloud Service Account with
# GSC Read + GA4 Viewer access (optional; can be connected anytime)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_JSON=
